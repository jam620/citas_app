# Copia este archivo a .env y ajusta si lo necesitas.
# Para el MVP los valores por defecto funcionan sin tocar nada.

# Carpeta donde están los CSV de origen
CITAS_DATA_DIR=data

# Ruta del archivo SQLite que genera el ETL
CITAS_DB_PATH=data/citas.db

# Tamaño máximo de página permitido en las consultas (anti-DoS)
CITAS_MAX_PAGE_SIZE=200

# Modo debug de FastAPI. Déjalo en false salvo que estés depurando.
CITAS_DEBUG=false
